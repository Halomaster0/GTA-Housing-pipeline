model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["GoldCsvFolder","dim_date","dim_municipality","dim_use_type","dim_status","dim_geography","fct_permits","fct_applications"]

annotation __PBI_TimeIntelligenceEnabled = 0

ref table dim_date
ref table dim_municipality
ref table dim_use_type
ref table dim_status
ref table dim_geography
ref table fct_permits
ref table fct_applications
