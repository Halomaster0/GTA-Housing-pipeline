/// One row per building permit (827,919 rows): Toronto 571,986, Brampton 221,319, Mississauga 34,614. Grain is the permit, not the project or the revision.
/// Collapse: Toronto per PERMIT_NUM (definitive beats Conditional, then max revision); Mississauga per BP_NO; Brampton per PERMITNUMBER (the row carrying DWELLINGS wins).
/// Date roles: date_issued_sk is the ACTIVE link to dim_date; date_applied_sk and date_closed_sk are inactive (USERELATIONSHIP).
table fct_permits
	lineageTag: ed6c0de9-1701-56a7-8473-2c6bdce5da91

	/// Permits that carry an issue date (date_issued_sk is not blank). This is the only valid 'issued' count and the only one that matches a by-year chart.
	/// Not the same as Permit Records. Permit Records is every permit row; this excludes rows with no issue date, which is a mix of permits never issued and permits whose issue date falls outside dim_date's 2010-2028 range (the split is not measured).
	/// Reference (docs/measure-reconciliation.json): 647,589 overall; Toronto 462,039, Brampton 150,936, Mississauga 34,614. If a card labelled 'Permits Issued' shows 827,919 it is Permit Records mislabelled, a 21.8% overstatement (build review D2).
	measure 'Permits Issued' = ```
			// M1. Permits that carry an issue date (date_issued_sk is not blank).
			// Not the same as Permit Records, which counts every permit row.
			CALCULATE (
				COUNTROWS ( fct_permits ),
				NOT ( ISBLANK ( fct_permits[date_issued_sk] ) )
			)
			```
		formatString: #,0
		lineageTag: 43c03403-4bb9-5c8a-8367-4b3d9504a8d6

	/// Every row in fct_permits: the total permit population, one row per building permit, regardless of status or dates. NOT 'permits issued'.
	/// 180,330 of these rows (21.8%) have no date_issued_sk, so they cannot be placed on the date axis: a by-year chart sums to Permits Issued, not to this measure.
	/// Reference (docs/measure-reconciliation.json): 827,919 overall; Toronto 571,986, Brampton 221,319, Mississauga 34,614.
	measure 'Permit Records' = ```
			// Every row in fct_permits, whether or not the permit has an issue date.
			COUNTROWS ( fct_permits )
			```
		formatString: #,0
		lineageTag: 7d0176dd-37ec-52f4-9d9a-692cf4e49fcb

	/// CAVEAT, MIXED BASIS: units are mixed-basis. Toronto is created minus lost (net), Mississauga res_units and Brampton dwellings taken as reported with no loss adjustment. Whether those source fields are gross or net is undocumented (ADR-0003), so cross-municipality sums are not comparable (ADR-0003). Show it per municipality and never show a grand total.
	/// 64.3% of permit rows (532,330 of 827,919) carry no unit count: Brampton 60.1%, Mississauga 80.9%, Toronto 64.9%. SUM skips them; they are not zeros.
	/// Gold stamps unit_count_basis = 'unknown' on every row pending source documentation (ADR-0003). Negative values are real Toronto demolition losses.
	/// Reference (docs/measure-reconciliation.json): Toronto 259,840; Brampton 78,957; Mississauga 30,968. Their sum, 369,765, is NOT a valid figure.
	measure 'Net New Units' = ```
			// M2. Sum of unit_count_net_new; NULL rows are skipped by SUM.
			// Mixed basis: do not total across municipalities (ADR-0003).
			SUM ( fct_permits[unit_count_net_new] )
			```
		formatString: #,0
		lineageTag: ed87eff4-2c4a-5e02-b1e0-ede2c56fb425

	/// Share of permit records that carry both date_applied_sk and date_issued_sk: the population Median Applied to Issued Days is computed over. Show it wherever that median is shown, because each municipality's median covers a different share of its permits.
	/// Reference (docs/measure-reconciliation.json): 645,382 of 827,919 = 78.0% overall; Toronto 80.4% (460,121 of 571,986), Mississauga 99.9% (34,581 of 34,614), Brampton 68.1% (150,680 of 221,319).
	measure 'Date Coverage Pct' = ```
			// Share of permit rows that have BOTH an applied date and an issued date.
			DIVIDE (
				CALCULATE (
					COUNTROWS ( fct_permits ),
					NOT ( ISBLANK ( fct_permits[date_applied_sk] ) ),
					NOT ( ISBLANK ( fct_permits[date_issued_sk] ) )
				),
				COUNTROWS ( fct_permits )
			)
			```
		formatString: 0.0%
		lineageTag: 5e7fb914-1d95-5efa-ad5c-2b1d955638b2

	/// Median whole days from application to issue, over permits that have both dates (645,382 of 827,919). Valid per municipality only: coverage differs by municipality (see Date Coverage Pct), so do not average the three medians into a GTA figure.
	/// Reference (docs/measure-reconciliation.json): Toronto 28 days (n=460,121), Mississauga 34 (n=34,581), Brampton 44 (n=150,680).
	/// Computed through dim_date[calendar_date] with LOOKUPVALUE, never by subtracting date_sk values.
	measure 'Median Applied to Issued Days' = ```
			// M6. Median whole days from applied to issued, over permits with both dates.
			// LOOKUPVALUE form: needs no role-playing date tables.
			MEDIANX (
				FILTER (
					fct_permits,
					NOT ( ISBLANK ( fct_permits[date_applied_sk] ) )
						&& NOT ( ISBLANK ( fct_permits[date_issued_sk] ) )
				),
				DATEDIFF (
					LOOKUPVALUE ( dim_date[calendar_date], dim_date[date_sk], fct_permits[date_applied_sk] ),
					LOOKUPVALUE ( dim_date[calendar_date], dim_date[date_sk], fct_permits[date_issued_sk] ),
					DAY
				)
			)
			```
		formatString: #,0.0
		lineageTag: ad95f7d0-cf3c-577b-9795-2cf7d52ecd1f

	/// Sum of construction_value_cad (CAD). Toronto and Mississauga only: the Brampton feed has no value field, so Brampton returns blank, not zero. Toronto has 373,693 permits with no value, so this is a sum over reported values, not over all permits.
	/// Reference (docs/measure-reconciliation.json): Toronto $100,991,303,902; Mississauga $18,269,933,097.
	measure 'Construction Value CAD' = ```
			// M8. Sum of declared construction value in CAD; blank where the source has none.
			SUM ( fct_permits[construction_value_cad] )
			```
		formatString: \$#,0
		lineageTag: d4433ddd-d68b-5c5a-86b0-d94ea01ac852

	/// Surrogate key, one per permit row.
	column permit_sk
		dataType: int64
		formatString: 0
		lineageTag: 2d959ee7-f2b8-5da7-bec9-1c3958babd69
		summarizeBy: none
		sourceColumn: permit_sk

	/// FK to dim_municipality. Never NULL.
	column municipality_sk
		dataType: int64
		formatString: 0
		lineageTag: f3a0c772-e070-509d-a5fb-3a46aa1fcbe7
		summarizeBy: none
		sourceColumn: municipality_sk

	/// Business key: the municipality's own permit number.
	column permit_number
		dataType: string
		lineageTag: b38f29c3-630b-5c84-8964-7ae4931add66
		summarizeBy: none
		sourceColumn: permit_number

	/// FK to dim_geography. NULL on 793,305 of 827,919 rows: only Mississauga permits carry a ward. Toronto (grid reference) and Brampton (no ward) are NULL.
	column geography_sk
		dataType: int64
		formatString: 0
		lineageTag: 1a79f595-f1b5-598f-9584-4fa2b5c7ec3b
		summarizeBy: none
		sourceColumn: geography_sk

	/// FK to dim_use_type. Never NULL.
	column use_type_sk
		dataType: int64
		formatString: 0
		lineageTag: 4285ea3f-f18f-5abe-b3f3-3b45ea4c7eba
		summarizeBy: none
		sourceColumn: use_type_sk

	/// Source type field before conformance: Toronto permit_type, Mississauga file_type, Brampton subdesc. Preserved for audit.
	column use_type_raw
		dataType: string
		lineageTag: fd92914c-6282-562d-8e2e-d96408af1974
		summarizeBy: none
		sourceColumn: use_type_raw

	/// How use_type_sk was assigned. 'source-field-mapped' on every row: mapped from the source type field by the conformance crosswalk.
	column use_type_classification_method
		dataType: string
		lineageTag: e7bf796c-a365-5bae-9171-8f59a6061945
		summarizeBy: none
		sourceColumn: use_type_classification_method

	/// FK to dim_status (permit track). Never NULL.
	column status_sk
		dataType: int64
		formatString: 0
		lineageTag: 5d7f5e29-2e51-54a9-bbd9-7cd3a8ae14b7
		summarizeBy: none
		sourceColumn: status_sk

	/// Source status text before conformance. Preserved for audit.
	column status_raw
		dataType: string
		lineageTag: 459df884-0872-5139-85d1-fb1a28cd4c47
		summarizeBy: none
		sourceColumn: status_raw

	/// FK to dim_date, applied role. INACTIVE relationship: activate per measure with USERELATIONSHIP. NULL when the source has no applied date or it falls outside dim_date's 2010-2028 range.
	column date_applied_sk
		dataType: int64
		formatString: 0
		lineageTag: e4125634-f1d7-5ff0-8e72-41b447e708e3
		summarizeBy: none
		sourceColumn: date_applied_sk

	/// FK to dim_date, issued role. The ACTIVE date relationship, so time axes show permits by issue date. NULL on 180,330 of 827,919 rows (21.8%): never issued, or issue date outside dim_date's 2010-2028 range (split not measured).
	column date_issued_sk
		dataType: int64
		formatString: 0
		lineageTag: ba5a107d-9a76-5418-8c2a-990fe3eaa2a4
		summarizeBy: none
		sourceColumn: date_issued_sk

	/// FK to dim_date, closed role. INACTIVE relationship. Always NULL for Brampton (no closed date in source).
	column date_closed_sk
		dataType: int64
		formatString: 0
		lineageTag: 2ac2ce0e-4b5d-5c45-a48c-5c907f322f7f
		summarizeBy: none
		sourceColumn: date_closed_sk

	/// Units, MIXED BASIS: Toronto created minus lost (only when both are reported), Mississauga res_units and Brampton dwellings as reported, with no loss adjustment and their gross-or-net semantics undocumented. Not comparable across municipalities (ADR-0003). NULL on 64.3% of rows (not reported, never coerced to 0). Negatives are real demolition losses. Use the Net New Units measure.
	column unit_count_net_new
		dataType: int64
		formatString: #,0
		lineageTag: 1646e067-f537-5178-9562-1df05efca216
		summarizeBy: none
		sourceColumn: unit_count_net_new

	/// Always 'unknown' in v1 (ADR-0003): the default until source semantics are confirmed, never assumed net-new.
	column unit_count_basis
		dataType: string
		lineageTag: e10d4425-5ecf-58ce-b696-f560f6e760f4
		summarizeBy: none
		sourceColumn: unit_count_basis

	/// Declared construction value in CAD. Toronto and Mississauga only; Brampton has no value field (all 221,319 rows NULL).
	column construction_value_cad
		dataType: decimal
		formatString: \$#,0.00
		lineageTag: a6854f2e-ef53-555c-ad29-c70771ace406
		summarizeBy: none
		sourceColumn: construction_value_cad

	/// Floor area in square metres where the source reports one (Toronto: sum of the eight area fields; Mississauga appl_area; Brampton floor_area_raw), else NULL.
	column floor_area_sqm
		dataType: double
		formatString: #,0.0
		lineageTag: 6d717462-dc21-56d4-a37e-729755f143e1
