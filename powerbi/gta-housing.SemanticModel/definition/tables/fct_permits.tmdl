	/// Timestamp the row was written to gold (lineage).
	column row_loaded_at
		dataType: dateTime
		lineageTag: 2af605a3-fc6e-5302-9f99-b31778a7e57f
		summarizeBy: none
		sourceColumn: row_loaded_at

	partition fct_permits = m
		mode: import
		source =
				let
					Source = Csv.Document(
						File.Contents(Text.TrimEnd(GoldCsvFolder, {"\", "/"}) & "\gold.fct_permits.csv"),
						[Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
					),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
					Typed = Table.TransformColumnTypes(
						Promoted,
						{
							{"permit_sk", Int64.Type},
							{"municipality_sk", Int64.Type},
							{"permit_number", type text},
							{"geography_sk", Int64.Type},
							{"use_type_sk", Int64.Type},
							{"use_type_raw", type text},
							{"use_type_classification_method", type text},
							{"status_sk", Int64.Type},
							{"status_raw", type text},
							{"date_applied_sk", Int64.Type},
							{"date_issued_sk", Int64.Type},
							{"date_closed_sk", Int64.Type},
							{"unit_count_net_new", Int64.Type},
							{"unit_count_basis", type text},
							{"construction_value_cad", Currency.Type},
							{"floor_area_sqm", type number},
							{"related_application_number", type text},
							{"ingest_batch_id", type text},
							{"row_loaded_at", type datetimezone}
						},
						"en-US"
					)
				in
					Typed
