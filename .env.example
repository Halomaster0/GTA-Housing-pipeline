# GTA Housing Pipeline -- environment variables.
#
# Copy to `.env` and fill in locally. Never commit `.env` (see .gitignore) and
# never put a real value in this file -- it is the only file that gets read by a
# stranger cloning the repo, and it stays public forever.

# --- AI query layer (Phase 4) ---------------------------------------------

# Anthropic API key used by the planner/executor/critic graph (src/ai). Required
# only once the AI layer is wired up; nothing in Phase 1-3 reads this.
ANTHROPIC_API_KEY=

# Hard ceiling, in whole USD, on LLM spend across all queries in a single UTC day.
# Once hit, POST /ask serves cached example answers and says so plainly instead of
# calling the model (see src/api, R10 in docs/build-plan.md §9).
LLM_DAILY_SPEND_CEILING_USD=

# Requests allowed per client IP per minute against the public API (slowapi).
API_RATE_LIMIT_PER_MINUTE=

# --- Serving layer: Microsoft Fabric / OneLake (Phase 3) -------------------

# Entra ID tenant that owns the Fabric capacity and workspace.
FABRIC_TENANT_ID=

# GUID of the Fabric workspace hosting the OneLake lakehouse gold tables publish into.
FABRIC_WORKSPACE_ID=

# Name of the Fabric Lakehouse that mirrors models/gold/*.sql output.
FABRIC_LAKEHOUSE_NAME=

# Connection string (or key-vault reference -- never a literal secret in real use)
# used to write gold/*.parquet into OneLake.
FABRIC_ONELAKE_CONNECTION_STRING=

# --- Local warehouse ---------------------------------------------------------

# Filesystem path to the local DuckDB database file. DuckDB remains the
# source of truth for development regardless of Fabric's availability.
DUCKDB_PATH=

# --- Public web app (Phase 4b) ----------------------------------------------

# Base URL the Next.js app (web/) calls for the FastAPI service, e.g.
# http://localhost:8000 in local dev, the deployed API origin in production.
API_BASE_URL=

# --- Cross-cutting -----------------------------------------------------------

# Log level for structlog output across src/*: DEBUG | INFO | WARNING | ERROR.
# Empty defaults to INFO in code.
LOG_LEVEL=
