# GTA Housing Pipeline -- environment variables.
#
# Copy to `.env` (git-ignored) and fill in only what you need. Never put a real
# value in this file: it is public and stays public in git history.
#
# Optional settings are commented out on purpose. A line such as
# `LLM_DAILY_SPEND_CEILING_USD=` sets an empty string, which crashes
# src/common/config.py on import. Uncomment a line only to change its default.
#
# Every variable below is read by src/common/config.py. Nothing else is read.

# --- Query layer and eval harness (src/common/llm.py, src/ai, evals/) -----------

# OpenRouter key for every LLM call. Required for /ask and for the eval harness.
OPENROUTER_API_KEY=

# Ceiling on LLM spend, in USD, per UTC day. Default 2.0.
# LLM_DAILY_SPEND_CEILING_USD=2.0

# Requests allowed per client IP per minute against the FastAPI service. Default 60.
# API_RATE_LIMIT_PER_MINUTE=60

# --- Warehouse -------------------------------------------------------------------

# DuckDB file read by /ask and the eval harness. Default data/warehouse-sept.duckdb,
# which no command in this repo creates. To use the warehouse that `make transform`
# builds instead, uncomment the next line.
# DUCKDB_PATH=data/warehouse.duckdb

# --- Web app (web/) --------------------------------------------------------------

# Base URL of the FastAPI service the web app calls. Default http://localhost:8000.
# API_BASE_URL=http://localhost:8000

# --- Logging ---------------------------------------------------------------------

# structlog level: DEBUG | INFO | WARNING | ERROR. Default INFO.
# LOG_LEVEL=INFO
