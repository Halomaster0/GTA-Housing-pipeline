# Secrets -- never committed, not even briefly (see docs/build-plan.md §0.1, R9).
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/
.coverage
htmlcov/

# Local warehouse and pipeline data layers -- these are regenerated by
# `make ingest` / `make transform`, never hand-edited, never committed.
# Anchored to root: unanchored patterns would also match models/silver/,
# models/gold/ (hand-written SQL, committed) and tests/data/ (tests, committed).
/data/
*.duckdb
*.duckdb.wal
/bronze/
/silver/
/gold/

# Pipeline checkpoint state (src/ingest resumable checkpoints).
state/*
!state/.gitkeep

# Traces: sample traces are committed on purpose (docs/build-plan.md §7); every
# other trace is a real query log and stays local.
traces/*
!traces/sample-*.json
!traces/.gitkeep

# Node / web (web/, Next.js on Vercel)
node_modules/
.next/
web/out/
.vercel/
*.tsbuildinfo
npm-debug.log*

# OS and editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Local Claude Code state: per-machine permissions and nested agent worktrees.
# Committed agent definitions under .claude/agents/ stay tracked.
.claude/settings.local.json
.claude/worktrees/

# Output written by CI steps or local runs; never committed.
verify_output.txt
coverage.xml
*.log

# Power BI Desktop writes these back into a PBIP project when it opens one.
# localSettings.json carries absolute machine paths and the signed-in user's
# cache location, so it must never reach a public repository. The committed
# project is the generated TMDL (scripts/generate_pbip.py); everything Desktop
# adds locally is disposable.
**/.pbi/localSettings.json
**/.pbi/cache.abf
*.pbix
*.abf

# Power BI Desktop local cache (per user, never shared)
.pbi/

# Terraform (infra/aws). State holds resource IDs and can hold secrets, so it never
# leaves the machine. Real *.tfvars hold the alert email and deployer ARN. The
# lock file (.terraform.lock.hcl) is committed on purpose.
*.tfstate
*.tfstate.*
.terraform/
*.tfvars
!*.tfvars.example
crash.log
*.tfplan
infra/aws/tfplan
